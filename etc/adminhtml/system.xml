<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Config:etc/system_file.xsd">
    <system>
        <tab id="magebooster" translate="label" sortOrder="400">
            <label>MageBooster</label>
        </tab>
        <section id="magebooster_license" translate="label" sortOrder="10" showInDefault="1">
            <label>Licenses</label>
            <tab>magebooster</tab>
            <resource>MageBooster_License::config</resource>
            <group id="status" translate="label" sortOrder="5" showInDefault="1">
                <label>License status</label>
                <field id="overview" translate="label" sortOrder="10" showInDefault="1">
                    <label>Status</label>
                    <frontend_model>MageBooster\License\Block\Adminhtml\System\Config\Overview</frontend_model>
                </field>
            </group>
            <group id="serials" translate="label comment" sortOrder="10" showInDefault="1">
                <label>Serial numbers</label>
                <comment><![CDATA[Paid MageBooster modules need a serial number for your store domain(s). Without a valid serial number a module keeps working for 30 days, then its paid function switches off. Development hosts (localhost, *.localhost, *.test, *.local, 127.0.0.1) always pass the domain check. Your serial numbers: <a href="https://store.magebooster.com/licences/account/" target="_blank" rel="noopener">store.magebooster.com/licences/account</a>]]></comment>
            </group>
        </section>
    </system>
</config>
